---
// Old-fashioned arcade cabinet. The game list lives in src/scripts/arcade.js;
// the labels below must stay in the same order as GAMES there.
const games = ['Catch the OJ', 'Match Up', 'Bunny Hop'];
---
<div class="cabinet" id="arcade" data-dir="">
  <div class="marquee"><span>Elizabeth's Arcade</span></div>

  <div class="bezel">
    <canvas width="320" height="240" role="img" aria-label="Arcade game screen"></canvas>
    <div class="glare" aria-hidden="true"></div>
  </div>

  <p class="sr-only" aria-live="polite" data-status></p>

  <div class="panel">
    <div class="stick" aria-hidden="true"><div class="ball"></div></div>

    <div class="selector" role="group" aria-label="Choose a game">
      {games.map((name, i) => (
        <button type="button" class="pick" data-game={i} aria-pressed="false">
          <span class="num">{i + 1}</span>
          <span class="name">{name}</span>
        </button>
      ))}
    </div>

    <button type="button" class="start" data-start>Start</button>
  </div>

  <div class="coin" aria-hidden="true">
    <span class="slot"></span><span class="slot"></span>
    <span class="coin-text">25&cent;</span>
  </div>

  <p class="keys">Keys: arrow keys and space. On a phone, tap the screen.</p>
</div>

<script>
  import { startArcade } from '../scripts/arcade.js';
  const root = document.getElementById('arcade');
  if (root) startArcade(root);
</script>

<style>
  .cabinet {
    background: var(--pink);
    border: 4px solid var(--ink);
    border-radius: 28px 28px 8px 8px;
    box-shadow: inset 14px 0 0 var(--blue), inset -14px 0 0 var(--blue), 8px 8px 0 var(--ink);
    padding: 14px 30px 18px;
    display: grid;
    gap: 14px;
  }

  .marquee {
    background: var(--ink);
    border: 3px solid var(--blue);
    border-radius: 10px;
    padding: 12px 8px;
    text-align: center;
  }
  .marquee span {
    font-family: 'Press Start 2P', monospace;
    font-size: clamp(0.7rem, 3.4vw, 1rem);
    color: #ffd23f;
    text-shadow: 0 0 8px #ffb300;
    letter-spacing: 0.04em;
  }

  .bezel {
    position: relative;
    background: var(--ink);
    border: 6px solid #3b2f63;
    border-radius: 14px;
    padding: 8px;
  }
  canvas {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    border-radius: 8px;
    background: #1a1033;
    image-rendering: pixelated;
    touch-action: none; /* lets a finger drag the basket without scrolling the page */
  }
  .glare {
    position: absolute;
    inset: 14px;
    border-radius: 8px;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.12), transparent 35%);
  }

  .panel {
    background: var(--pink-dark);
    border: 3px solid var(--ink);
    border-radius: 10px 10px 18px 18px;
    padding: 12px;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 12px;
    align-items: center;
  }

  .stick {
    width: 44px;
    height: 56px;
    display: grid;
    place-items: end center;
    position: relative;
  }
  .stick::before {
    content: '';
    position: absolute;
    bottom: 0;
    width: 40px;
    height: 12px;
    border-radius: 50%;
    background: var(--ink);
  }
  .ball {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: #ffd23f;
    border: 3px solid var(--ink);
    position: relative;
    margin-bottom: 20px;
    transition: transform 0.08s;
  }
  .ball::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 100%;
    width: 6px;
    height: 20px;
    background: var(--ink);
    transform: translateX(-50%);
  }
  #arcade[data-dir='left'] .ball { transform: translateX(-8px) rotate(-12deg); }
  #arcade[data-dir='right'] .ball { transform: translateX(8px) rotate(12deg); }

  .selector {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    min-width: 0;
  }
  .pick {
    font: inherit;
    cursor: pointer;
    background: var(--blue-light);
    color: var(--ink);
    border: 3px solid var(--ink);
    border-radius: 10px;
    padding: 6px 4px;
    display: grid;
    gap: 2px;
    justify-items: center;
    box-shadow: 0 4px 0 var(--ink);
    min-width: 0;
  }
  .pick .num {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.9rem;
  }
  .pick .name {
    font-size: 0.7rem;
    font-weight: bold;
    line-height: 1.1;
    text-align: center;
  }
  .pick[aria-pressed='true'] {
    background: #ffd23f;
    box-shadow: 0 0 0 var(--ink), 0 0 14px #ffd23f;
    transform: translateY(4px);
  }

  .start {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.7rem;
    cursor: pointer;
    background: #e0245e;
    color: white;
    border: 3px solid var(--ink);
    border-radius: 50%;
    width: 68px;
    height: 68px;
    box-shadow: 0 5px 0 var(--ink);
  }
  .start:active {
    transform: translateY(5px);
    box-shadow: 0 0 0 var(--ink);
  }

  .coin {
    background: var(--ink);
    border-radius: 10px;
    padding: 10px 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .slot {
    width: 8px;
    height: 30px;
    background: #000;
    border: 2px solid #ffd23f;
    border-radius: 3px;
  }
  .coin-text {
    font-family: 'Press Start 2P', monospace;
    font-size: 0.6rem;
    color: #ffd23f;
  }

  .keys {
    margin: 0;
    font-size: 0.8rem;
    text-align: center;
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .cabinet { padding-inline: 24px; }
    .panel { grid-template-columns: 1fr auto; }
    .stick { display: none; }
  }
</style>
