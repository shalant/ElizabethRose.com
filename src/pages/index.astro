---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArcadeMachine from '../components/ArcadeMachine.astro';

import halloween from '../assets/elizabethWalkerHalloween.jpg';
import photo1 from '../assets/20230930_122555.jpg';
import photo2 from '../assets/20230930_122559.jpg';
import photo3 from '../assets/20230930_122605.jpg';
import orangeJuice from '../assets/orangeJuice.png';

// To add a photo to the wall: put the file in src/assets, import it above,
// and add a line here. TODO: ask Elizabeth what each picture is, then write
// a real description in `alt` (it is read aloud for people who can't see it).
const wall = [
  { src: photo1, alt: 'Something Elizabeth likes' },
  { src: photo2, alt: 'Something Elizabeth likes' },
  { src: photo3, alt: 'Something Elizabeth likes' },
  { src: orangeJuice, alt: 'A glass of orange juice' },
];
---
<Base>
  <header class="top">Elizabeth Rose Dot Com</header>

  <main>
    <section class="two">
      <Image class="hero" src={halloween} alt="Elizabeth and her brother Walker on Halloween" width={640} />
      <div class="about">
        <h1>Hi, I'm Elizabeth!</h1>
        <p>I am 6 years old.</p>
        <p>I have an awesome brother named Walker.</p>
        <p>I enjoy OJ!</p>
      </div>
    </section>

    <section class="arcade" aria-labelledby="arcade-heading">
      <h2 id="arcade-heading">Play my arcade!</h2>
      <ArcadeMachine />
      <div class="more">
        <h3>More games</h3>
        <div class="links">
          <a class="play" href="https://www.lego.com/en-us/kids/games/old-friends/heartlake-rush-ebc3def3476b40a1bfd0b38755a2df18" target="_blank" rel="noopener noreferrer">Play Heartlake Rush</a>
          <a class="play blue" href="https://www.crazygames.com" target="_blank" rel="noopener noreferrer">Even more on CrazyGames</a>
        </div>
      </div>
    </section>

    <section class="wallwrap">
      <h2>Here are some things I like</h2>
      <div class="wall">
        {wall.map((p) => <Image src={p.src} alt={p.alt} width={400} height={400} />)}
      </div>
    </section>
  </main>

  <footer>Copyright 2025 V2</footer>
</Base>

<style>
  .top {
    background: var(--pink);
    color: white;
    text-align: center;
    padding: 12px 16px;
    font-size: 1.3rem;
    font-weight: bold;
  }
  footer {
    background: var(--pink);
    color: white;
    text-align: center;
    padding: 10px;
    font-size: 0.85rem;
  }

  /* about me: photo and words side by side, stacked on a phone */
  .two {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
    align-items: center;
    max-width: 900px;
    margin: 0 auto;
    padding: 24px 16px;
  }
  .hero {
    width: 100%;
    height: auto;
    border: 4px solid var(--pink);
    border-radius: 12px;
  }
  .about {
    background: white;
    border: 3px solid var(--blue);
    border-radius: 16px;
    padding: 16px;
  }
  .about h1 {
    color: var(--pink);
    margin-top: 0;
  }

  .arcade {
    max-width: 520px;
    margin: 0 auto;
    padding: 8px 16px 32px;
  }
  .arcade h2 {
    text-align: center;
    margin: 0 0 16px;
  }

  .more {
    margin-top: 24px;
    text-align: center;
  }
  .more h3 {
    margin: 0 0 10px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .play {
    display: inline-block;
    background: var(--pink);
    color: white;
    padding: 10px 18px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: bold;
    border: 3px solid var(--ink);
    box-shadow: 0 4px 0 var(--ink);
  }
  .play.blue {
    background: var(--blue);
    color: var(--ink);
  }

  /* photo wall: as many squares per row as fit */
  .wallwrap {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 16px 24px;
  }
  .wall {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 12px;
  }
  .wall :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: 4px solid var(--pink);
    border-radius: 12px;
  }
  .wall :global(img:nth-child(even)) {
    border-color: var(--blue);
  }
</style>
